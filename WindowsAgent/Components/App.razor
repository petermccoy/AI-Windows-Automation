@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Windows Agent</title>
    <base href="/" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <!-- Cache-busting query string: wwwroot/js is served as a plain static file with
         no fingerprinting, so browsers can keep an old cached copy indefinitely across
         reloads unless this changes. Bump it whenever agent.js changes meaningfully. -->
    <script src="js/agent.js?v=2"></script>
</body>
</html>
