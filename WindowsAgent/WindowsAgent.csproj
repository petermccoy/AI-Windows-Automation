<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows-only APIs (Process, PowerShell SDK) -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Voice -->
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.40.0" />

    <!-- Email/calendar via Microsoft Graph (M365/Outlook) -->
    <PackageReference Include="Microsoft.Graph" Version="5.56.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />

    <!-- Gmail/Google Calendar (Gmail has no app-only path — this is a per-user
         OAuth "Desktop app" client; see Google/GoogleAuthService.cs) -->
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.75.0.4225" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />

    <!-- Claude via AWS Bedrock (alternative to the direct Anthropic API) -->
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.7" />

    <!-- Local PowerShell execution -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.5" />

    <!-- Config / hosting -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

</Project>
